# ============================================
# Universal Media Downloader - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Server ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# ---- Database ----
# SQLite path for local development
DATABASE_PATH=./data/media-downloader.db

# ---- Redis ----
# Set to "memory" for in-memory mock (local dev), or a redis:// URL for production
REDIS_URL=memory

# ---- Admin ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-in-production
JWT_SECRET=change-this-to-a-random-64-char-string

# ---- Security ----
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_DOWNLOAD=10
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_DOWNLOADS=5
MAX_REQUEST_SIZE_MB=1

# ---- Storage ----
TEMP_DIR=./data/temp
TEMP_FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5

# ---- Logging ----
LOG_LEVEL=info
